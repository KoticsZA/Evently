@using Evently.Constants
@model Evently.ViewModels.Auth.RegisterViewModel
@{
    ViewData["Title"] = "Create account";
    const string inputBase = "w-full bg-surface-container-low text-on-surface font-body-md text-body-md placeholder:text-outline/70 px-4 py-3 rounded-lg border border-transparent focus:outline-none focus:bg-surface-container focus:border-primary/60 focus:text-on-surface transition-all shadow-sm";
}

<div class="flex flex-col w-full">
<div class="w-full min-h-[calc(100vh-4rem)] flex flex-col lg:flex-row">

    <!-- LEFT PANEL -->
    <div class="relative w-full lg:w-[44%] min-h-[460px] lg:min-h-full flex flex-col justify-between overflow-hidden bg-surface-container-lowest">
        <div class="absolute inset-0 z-0">
            <img alt="Intimate live jazz quintet performance inside a heritage brick and polished wood salon in Johannesburg"
                 class="w-full h-full object-cover object-center transform scale-105 duration-1000 ease-out"
                 src="https://lh3.googleusercontent.com/aida-public/AB6AXuBm_4kt10Rtkcg3LLXAFnfBGzA20LlrtKjKGFNFZX92ZqcDcKCaAr1dmvzhmHFoCv_bnOO3x6dJORzar0Z7a2YT-Cn6fiBb2PSu3-v5WHHX5F8fNf-wkMmSAnMaVGLrsv0fbtqKEsjRzwU0jmHBpzQLfEOrktlaPkJ26V9RCSSOM6B6m54aZvuz5EzBcOhiWIQS3ra2NYAMF_PE027N_4pZPc9zxm4xYIgNWk3WCI8" />
            <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/70 to-surface-container-lowest/30"></div>
            <div class="absolute inset-0 bg-surface-container-lowest/40 mix-blend-multiply"></div>
        </div>

        <div class="relative z-10 p-margin-mobile lg:p-margin pb-0">
            <div class="inline-flex items-center gap-space-xs px-3 py-1.5 rounded-full bg-surface-container-lowest/80 backdrop-blur-md shadow-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                <span class="font-label-caps text-label-caps uppercase tracking-widest text-primary">Curated Access • Mzansi</span>
            </div>
        </div>

        <div class="relative z-10 p-margin-mobile lg:p-margin flex flex-col gap-space-lg">
            <div class="flex flex-col gap-space-sm max-w-xl">
                <span class="font-label-caps text-label-caps uppercase tracking-widest text-on-surface-variant flex items-center gap-2">
                    <span class="material-symbols-outlined text-[14px] text-primary">nightlife</span>
                    The Cultural Stage
                </span>
                <h1 class="font-headline-lg text-headline-lg-mobile lg:text-headline-lg text-on-surface leading-tight tracking-tight">
                    Where South Africa's most memorable nights begin.
                </h1>
                <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed pt-1">
                    Discover intimate secret sets, premier wine-country festivals, and sold-out arena shows — all with guaranteed authenticity and instant digital gate-pass ticketing.
                </p>
            </div>

            <div class="bg-surface-container-low/90 backdrop-blur-md p-space-md rounded-xl shadow-lg flex flex-col sm:flex-row sm:items-center justify-between gap-space-md">
                <div class="flex items-center gap-space-sm">
                    <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary flex-shrink-0">
                        <span class="material-symbols-outlined text-[20px]">verified_user</span>
                    </div>
                    <div>
                        <p class="font-headline-sm text-headline-sm text-on-surface">280,000+</p>
                        <p class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider">Active Eventgoers</p>
                    </div>
                </div>
                <div class="h-8 w-[1px] bg-surface-variant hidden sm:block"></div>
                <div class="flex items-center gap-space-sm">
                    <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary flex-shrink-0">
                        <span class="material-symbols-outlined text-[20px]">confirmation_number</span>
                    </div>
                    <div>
                        <p class="font-headline-sm text-headline-sm text-on-surface">1,400+</p>
                        <p class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider">Premier Promoters</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="w-full lg:w-[56%] bg-surface flex flex-col justify-center px-margin-mobile sm:px-space-xl lg:px-margin py-space-xl">
        <div class="w-full max-w-xl mx-auto flex flex-col gap-space-lg">

            <div class="flex flex-col gap-space-xs">
                <div class="flex items-center gap-2">
                    <span class="font-label-caps text-label-caps uppercase tracking-widest text-primary font-bold">New Membership</span>
                    <span class="text-on-surface-variant">•</span>
                    <span class="font-label-caps text-label-caps uppercase tracking-wider text-on-surface-variant">Step 1 of 1</span>
                </div>
                <h2 class="font-headline-lg text-headline-lg-mobile lg:text-headline-lg text-on-surface font-semibold tracking-tight">Create your Evently account</h2>
                <p class="font-body-md text-body-md text-on-surface-variant">Join our community of live music, arts, and cultural enthusiasts across South Africa.</p>
            </div>

            <form asp-controller="Account" asp-action="Register" method="post" class="flex flex-col gap-space-md" novalidate>

                <div asp-validation-summary="ModelOnly"
                     class="rounded-lg bg-error-container/30 border border-error/30 text-error font-label-md text-label-md px-3 py-2.5" role="alert"></div>

                <!-- Names -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                    <div class="flex flex-col gap-1.5">
                        <label asp-for="FirstName" class="font-label-md text-label-md text-on-surface">First name <span class="text-primary">*</span></label>
                        <input asp-for="FirstName" autocomplete="given-name" placeholder="e.g. Kagiso" class="@inputBase" />
                        <span asp-validation-for="FirstName" class="text-error font-label-md text-label-md"></span>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label asp-for="LastName" class="font-label-md text-label-md text-on-surface">Last name <span class="text-primary">*</span></label>
                        <input asp-for="LastName" autocomplete="family-name" placeholder="e.g. Mokoena" class="@inputBase" />
                        <span asp-validation-for="LastName" class="text-error font-label-md text-label-md"></span>
                    </div>
                </div>

                <!-- Email -->
                <div class="flex flex-col gap-1.5">
                    <label asp-for="Email" class="font-label-md text-label-md text-on-surface">Email address <span class="text-primary">*</span></label>
                    <div class="relative flex items-center">
                        <span class="material-symbols-outlined absolute left-3.5 text-[20px] text-outline pointer-events-none">mail</span>
                        <input asp-for="Email" autocomplete="email" placeholder="kagiso.mokoena@@outlook.com" class="@inputBase pl-11" />
                    </div>
                    <span asp-validation-for="Email" class="text-error font-label-md text-label-md"></span>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">Your verified admission passes and event itineraries will be delivered here.</p>
                </div>

                <!-- DOB / Gender -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                    <div class="flex flex-col gap-1.5">
                        <label asp-for="DateOfBirth" class="font-label-md text-label-md text-on-surface">Date of birth <span class="text-primary">*</span></label>
                        <input asp-for="DateOfBirth" class="@inputBase [color-scheme:dark]" />
                        <span asp-validation-for="DateOfBirth" class="text-error font-label-md text-label-md"></span>
                        <span class="font-label-caps text-label-caps text-on-surface-variant flex items-center gap-1">
                            <span class="material-symbols-outlined text-[13px] text-primary">info</span>
                            Must be 18+ for licensed venues
                        </span>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label asp-for="Gender" class="font-label-md text-label-md text-on-surface">Gender <span class="text-on-surface-variant font-normal">(optional)</span></label>
                        <div class="relative flex items-center">
                            <select asp-for="Gender" class="@inputBase appearance-none cursor-pointer pr-10">
                                <option class="bg-surface-container-high text-on-surface-variant" value="">Select gender (optional)</option>
                                <option class="bg-surface-container-high text-on-surface" value="Female">Female</option>
                                <option class="bg-surface-container-high text-on-surface" value="Male">Male</option>
                                <option class="bg-surface-container-high text-on-surface" value="Non-binary">Non-binary</option>
                                <option class="bg-surface-container-high text-on-surface" value="Self-describe">Prefer to self-describe</option>
                                <option class="bg-surface-container-high text-on-surface" value="Prefer not to say">Prefer not to say</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-3 text-[20px] text-outline pointer-events-none">expand_more</span>
                        </div>
                    </div>
                </div>

                <!-- Province / City (data comes from Evently.Constants.SouthAfricaLocations) -->
                @{
                    var selectedCities = SouthAfricaLocations.CitiesFor(Model?.Province);
                }
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                    <div class="flex flex-col gap-1.5">
                        <label asp-for="Province" class="font-label-md text-label-md text-on-surface">Province <span class="text-primary">*</span></label>
                        <div class="relative flex items-center">
                            <select asp-for="Province" id="Province" autocomplete="off"
                                    class="@inputBase appearance-none cursor-pointer pr-10 [color-scheme:dark]">
                                <option value="">Select a province</option>
                                @foreach (var p in SouthAfricaLocations.Provinces)
                                {
                                    <option value="@p" selected="@(Model?.Province == p)">@p</option>
                                }
                            </select>
                            <span class="material-symbols-outlined absolute right-3 text-[20px] text-outline pointer-events-none">expand_more</span>
                        </div>
                        <span asp-validation-for="Province" class="text-error font-label-md text-label-md"></span>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label asp-for="City" class="font-label-md text-label-md text-on-surface">City <span class="text-primary">*</span></label>
                        <div class="relative flex items-center">
                            <select asp-for="City" id="City" autocomplete="off" disabled="@(selectedCities.Count == 0)"
                                    class="@inputBase appearance-none cursor-pointer pr-10 disabled:opacity-60 disabled:cursor-not-allowed [color-scheme:dark]">
                                <option value="">@(selectedCities.Count == 0 ? "Select a province first" : "Select a city")</option>
                                @foreach (var c in selectedCities)
                                {
                                    <option value="@c" selected="@(Model?.City == c)">@c</option>
                                }
                            </select>
                            <span class="material-symbols-outlined absolute right-3 text-[20px] text-outline pointer-events-none">expand_more</span>
                        </div>
                        <span asp-validation-for="City" class="text-error font-label-md text-label-md"></span>
                    </div>
                </div>

                <script>
                    (function () {
                        var cities = @Json.Serialize(SouthAfricaLocations.CitiesByProvince);
                        var province = document.getElementById('Province');
                        var city = document.getElementById('City');
                        if (!province || !city) return;

                        function fill(keep) {
                            var list = cities[province.value] || [];
                            var current = keep ? city.value : '';
                            city.innerHTML = '<option value="">' + (province.value ? 'Select a city' : 'Select a province first') + '</option>';
                            list.forEach(function (name) {
                                var o = document.createElement('option');
                                o.value = name;
                                o.textContent = name;
                                if (name === current) o.selected = true;
                                city.appendChild(o);
                            });
                            city.disabled = list.length === 0;
                        }

                        province.addEventListener('change', function () { fill(false); });
                        window.addEventListener('load', function () { fill(true); });                       // browser may restore the old province after load
                        window.addEventListener('pageshow', function (e) { if (e.persisted) fill(true); }); // back/forward cache
                        fill(true);
                    })();
                </script>

                <!-- Passwords -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                    <div class="flex flex-col gap-1.5">
                        <label asp-for="Password" class="font-label-md text-label-md text-on-surface">Password <span class="text-primary">*</span></label>
                        <div class="relative flex items-center">
                            <input asp-for="Password" autocomplete="new-password" placeholder="••••••••••••" class="@inputBase pr-11" />
                            <button type="button" data-toggle-password="Password" aria-label="Toggle password visibility"
                                    class="absolute right-2.5 p-1 rounded hover:bg-surface-container-high text-outline hover:text-on-surface transition-colors flex items-center justify-center">
                                <span class="material-symbols-outlined text-[19px]">visibility</span>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-error font-label-md text-label-md"></span>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label asp-for="ConfirmPassword" class="font-label-md text-label-md text-on-surface">Confirm password <span class="text-primary">*</span></label>
                        <div class="relative flex items-center">
                            <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="••••••••••••" class="@inputBase pr-11" />
                            <button type="button" data-toggle-password="ConfirmPassword" aria-label="Toggle confirm password visibility"
                                    class="absolute right-2.5 p-1 rounded hover:bg-surface-container-high text-outline hover:text-on-surface transition-colors flex items-center justify-center">
                                <span class="material-symbols-outlined text-[19px]">visibility</span>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-error font-label-md text-label-md"></span>
                    </div>
                </div>

                <!-- Live security criteria -->
                <div class="bg-surface-container-low p-3.5 rounded-lg flex flex-col gap-2.5 shadow-sm">
                    <div class="flex items-center justify-between">
                        <span class="font-label-caps text-label-caps uppercase tracking-wider text-on-surface-variant font-semibold">Security criteria</span>
                        <div class="hidden items-center gap-1 text-primary font-label-caps text-label-caps" id="criteriaMetBadge">
                            <span class="material-symbols-outlined text-[14px]">check_circle</span>
                            <span>Security standards met</span>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                        <div class="flex items-center gap-2 text-on-surface-variant transition-colors" id="ruleLength">
                            <span class="w-1.5 h-1.5 rounded-full bg-outline transition-colors rule-dot"></span>
                            <span class="font-body-sm text-body-sm">8+ characters</span>
                        </div>
                        <div class="flex items-center gap-2 text-on-surface-variant transition-colors" id="ruleUppercase">
                            <span class="w-1.5 h-1.5 rounded-full bg-outline transition-colors rule-dot"></span>
                            <span class="font-body-sm text-body-sm">Uppercase letter</span>
                        </div>
                        <div class="flex items-center gap-2 text-on-surface-variant transition-colors" id="ruleNumberOrSymbol">
                            <span class="w-1.5 h-1.5 rounded-full bg-outline transition-colors rule-dot"></span>
                            <span class="font-body-sm text-body-sm">Number or symbol</span>
                        </div>
                    </div>
                </div>

                <!-- Terms -->
                <div class="pt-1 flex flex-col gap-1.5">
                    <div class="flex items-start gap-3">
                        <div class="flex items-center h-5 mt-0.5">
                            <input asp-for="AcceptTerms" class="w-4 h-4 rounded bg-surface-container-low text-primary focus:ring-0 focus:outline-none cursor-pointer accent-primary" />
                        </div>
                        <label asp-for="AcceptTerms" class="font-body-sm text-body-sm text-on-surface-variant cursor-pointer select-none">
                            By selecting <strong class="text-on-surface font-semibold">Create account</strong>, you agree to Evently's
                            <a class="text-primary hover:underline underline-offset-4" href="#">Terms of Service</a>
                            and confirm you have reviewed our
                            <a class="text-primary hover:underline underline-offset-4" href="#">Privacy Charter</a>.
                        </label>
                    </div>
                    <span asp-validation-for="AcceptTerms" class="text-error font-label-md text-label-md"></span>
                </div>

                <div class="pt-2">
                    <button type="submit"
                            class="w-full bg-primary hover:bg-primary-container active:scale-[0.99] text-on-primary font-label-lg text-label-lg font-bold py-4 px-6 rounded-lg uppercase tracking-wider shadow-lg flex items-center justify-center gap-2 transition-all group cursor-pointer">
                        <span>Create account</span>
                        <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
                    </button>
                </div>

                <div class="text-center pt-2">
                    <p class="font-body-md text-body-md text-on-surface-variant">
                        Already have an account?
                        <a asp-controller="Account" asp-action="Login" class="text-primary hover:text-primary-container font-semibold transition-colors">Sign in</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/register.js" asp-append-version="true"></script>
}
