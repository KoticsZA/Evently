@using Evently.Helpers
@using Evently.ViewModels.Account
@using Evently.ViewModels.Bookings
@using Evently.ViewModels.Events
@model UserDashboardViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Overview";
    ViewData["ActiveNav"] = "overview";
    ViewData["FirstName"] = Model.FirstName;
    ViewData["TicketBadge"] = Model.UpcomingEvents.Sum(b => b.TotalTickets);

    var next = Model.NextEvent;
    var activity = Model.UpcomingEvents.OrderByDescending(b => b.BookingDate).Take(4).ToList();

    // Shared style tokens for this view (all colours come from the Tailwind theme, no hex values)
    const string ring    = "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary focus-visible:ring-offset-2 focus-visible:ring-offset-surface";
    const string card    = "rounded-xl border border-outline-variant bg-surface-container-low";
    const string h2      = "font-headline-sm text-headline-sm text-on-surface";
    const string textLink = "inline-flex items-center gap-1 font-label-lg text-label-lg text-secondary hover:text-primary transition-colors rounded";
}

<div class="w-full max-w-[1200px] mx-auto px-margin-mobile md:px-margin-tablet lg:px-margin py-10 flex flex-col gap-12">

    <!-- 1. GREETING + SEARCH -->
    <header class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
            <h1 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-on-surface tracking-tight">
                @UiFormat.Greeting(DateTime.Now)@(string.IsNullOrWhiteSpace(Model.FirstName) ? "" : ", " + Model.FirstName)
            </h1>
            <p class="font-body-lg text-body-lg text-on-surface-variant mt-1">Your next great experience is closer than you think.</p>
        </div>

        <form method="get" asp-controller="Events" asp-action="Index" role="search" class="w-full md:max-w-sm">
            <label for="eventSearch" class="sr-only">Search events</label>
            <div class="flex items-center gap-2 h-12 pl-4 pr-1.5 rounded-lg bg-surface-container-low border border-outline-variant focus-within:border-secondary transition-colors">
                <span class="material-symbols-outlined text-[20px] text-on-surface-variant" aria-hidden="true">search</span>
                <input id="eventSearch" name="q" type="search" autocomplete="off"
                       placeholder="Search artists, events or venues"
                       class="flex-1 min-w-0 bg-transparent border-0 p-0 text-on-surface placeholder:text-on-surface-variant focus:ring-0 focus:outline-none font-body-md text-body-md" />
                <button type="submit" class="h-9 px-4 rounded-lg bg-secondary text-on-secondary-container font-label-lg text-label-lg hover:bg-primary transition-colors cursor-pointer @ring">Search</button>
            </div>
        </form>
    </header>

    <!-- 2. SUMMARY STRIP -->
    <section aria-label="Summary" class="grid grid-cols-3 divide-x divide-outline-variant overflow-hidden @card">
        <a asp-controller="Bookings" asp-action="Index" class="px-4 sm:px-6 py-5 hover:bg-surface-container transition-colors @ring">
            <p class="font-headline-md text-headline-md text-on-surface">@Model.TotalBookings</p>
            <p class="font-body-sm text-body-sm text-on-surface-variant">@(Model.TotalBookings == 1 ? "Booking" : "Bookings")</p>
        </a>
        <a asp-controller="Bookings" asp-action="Index" class="px-4 sm:px-6 py-5 hover:bg-surface-container transition-colors @ring">
            <p class="font-headline-md text-headline-md text-on-surface">@Model.UpcomingEventsCount</p>
            <p class="font-body-sm text-body-sm text-on-surface-variant">
                Upcoming@(next is not null ? " · next " + UiFormat.ShortDate(next.EventStartDateTime) : "")
            </p>
        </a>
        <a href="#saved" class="px-4 sm:px-6 py-5 hover:bg-surface-container transition-colors @ring">
            <p class="font-headline-md text-headline-md text-on-surface">@Model.SavedEventsCount</p>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Saved</p>
        </a>
    </section>

    <!-- 3. NEXT EVENT -->
    <section aria-labelledby="next-heading" class="flex flex-col gap-4">
        <div class="flex items-center justify-between gap-4">
            <h2 id="next-heading" class="@h2">Your next event</h2>
            @if (next is not null)
            {
                <a asp-controller="Bookings" asp-action="Index" class="@textLink @ring">All bookings</a>
            }
        </div>

        @if (next is null)
        {
            <div class="@card px-6 py-12 flex flex-col items-center text-center gap-4">
                <span class="material-symbols-outlined text-[32px] text-secondary" aria-hidden="true">confirmation_number</span>
                <div>
                    <h3 class="font-title-md text-title-md text-on-surface">No upcoming events</h3>
                    <p class="font-body-md text-body-md text-on-surface-variant mt-1 max-w-sm">Once you book, your pass and entry QR code will show up here.</p>
                </div>
                <a asp-controller="Events" asp-action="Index"
                   class="h-11 px-6 rounded-lg bg-secondary text-on-secondary-container font-label-lg text-label-lg hover:bg-primary transition-colors inline-flex items-center gap-2 @ring">
                    Discover events
                    <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_forward</span>
                </a>
            </div>
        }
        else
        {
            var tickets = next.Tickets.ToList();
            var qrValue = tickets.FirstOrDefault()?.QRCodeValue ?? next.BookingReference;
            var tiers = string.Join(", ", tickets.Select(t => t.TicketTypeName).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct());
            var where = string.IsNullOrWhiteSpace(next.City) ? next.VenueName : next.VenueName + ", " + next.City;

            <article class="grid grid-cols-1 lg:grid-cols-5 overflow-hidden @card">
                <!-- Event -->
                <div class="lg:col-span-3 relative min-h-[320px] lg:min-h-[400px] flex flex-col justify-between p-6 sm:p-8 overflow-hidden">
                    @if (!string.IsNullOrWhiteSpace(next.EventCoverImageUrl))
                    {
                        <img src="@next.EventCoverImageUrl" alt="" class="absolute inset-0 w-full h-full object-cover" />
                    }
                    <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/70 to-surface-container-lowest/20"></div>

                    <div class="relative">
                        <span class="inline-flex items-center h-7 px-3 rounded-full bg-secondary text-on-secondary-container font-label-md text-label-md">
                            @UiFormat.DaysUntil(next.EventStartDateTime)
                        </span>
                    </div>

                    <div class="relative flex flex-col gap-4">
                        <h3 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-on-surface leading-tight">@next.EventTitle</h3>
                        <ul class="flex flex-col gap-2 font-body-md text-body-md text-on-surface">
                            <li class="flex items-start gap-2.5">
                                <span class="material-symbols-outlined text-[20px] text-secondary shrink-0" aria-hidden="true">calendar_today</span>
                                <span>@UiFormat.LongDay(next.EventStartDateTime) · @UiFormat.Time(next.EventStartDateTime)@(next.EventEndDateTime > next.EventStartDateTime ? " – " + UiFormat.Time(next.EventEndDateTime) : "")</span>
                            </li>
                            <li class="flex items-start gap-2.5">
                                <span class="material-symbols-outlined text-[20px] text-secondary shrink-0" aria-hidden="true">location_on</span>
                                <span>@where</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Pass -->
                <div class="lg:col-span-2 p-6 sm:p-8 flex flex-col gap-6 border-t lg:border-t-0 lg:border-l border-outline-variant bg-surface-container-lowest">
                    <div class="flex flex-col items-center gap-3">
                        <div class="p-4 rounded-lg bg-white">
                            <div id="qrTarget" class="qr-box w-36 h-36 flex items-center justify-center text-on-secondary-container font-label-md text-label-md break-all text-center"
                                 role="img" aria-label="Entry QR code" data-qr="@qrValue">@next.BookingReference</div>
                        </div>
                        <p id="qrCaption" class="font-body-sm text-body-sm text-on-surface-variant">@(tickets.Count > 0 ? "Pass " + tickets[0].TicketNumber : "Entry pass")</p>

                        @if (tickets.Count > 1)
                        {
                            <div class="flex flex-wrap justify-center gap-2" role="group" aria-label="Choose a pass">
                                @for (var i = 0; i < tickets.Count; i++)
                                {
                                    <button type="button" aria-pressed="@(i == 0 ? "true" : "false")"
                                            data-qr-select="@tickets[i].QRCodeValue" data-qr-label="Pass @tickets[i].TicketNumber"
                                            class="h-9 px-3 rounded-lg border border-outline-variant text-on-surface font-label-md text-label-md transition-colors cursor-pointer hover:bg-surface-container aria-pressed:bg-secondary aria-pressed:text-on-secondary-container aria-pressed:border-secondary @ring">
                                        Pass @(i + 1)
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <dl class="divide-y divide-outline-variant font-body-sm text-body-sm">
                        <div class="flex justify-between gap-4 py-2.5">
                            <dt class="text-on-surface-variant">Reference</dt>
                            <dd class="text-on-surface text-right">@next.BookingReference</dd>
                        </div>
                        <div class="flex justify-between gap-4 py-2.5">
                            <dt class="text-on-surface-variant">Admission</dt>
                            <dd class="text-on-surface text-right">@(string.IsNullOrWhiteSpace(tiers) ? "General" : tiers)</dd>
                        </div>
                        <div class="flex justify-between gap-4 py-2.5">
                            <dt class="text-on-surface-variant">Passes</dt>
                            <dd class="text-on-surface text-right">@next.TotalTickets</dd>
                        </div>
                    </dl>

                    <div class="flex flex-col gap-2 mt-auto">
                        <a asp-controller="Bookings" asp-action="Details" asp-route-id="@next.TicketOrderId"
                           class="h-11 rounded-lg bg-secondary text-on-secondary-container font-label-lg text-label-lg hover:bg-primary transition-colors flex items-center justify-center gap-2 @ring">
                            View ticket
                        </a>
                        <div class="grid grid-cols-2 gap-2">
                            <a href="@UiFormat.MapsUrl(where)" target="_blank" rel="noopener"
                               class="h-10 rounded-lg border border-outline-variant text-on-surface font-label-md text-label-md hover:bg-surface-container transition-colors flex items-center justify-center gap-1.5 @ring">
                                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">directions</span>Directions
                            </a>
                            <a href="@UiFormat.GoogleCalendarUrl(next.EventTitle, next.EventStartDateTime, next.EventEndDateTime, where)" target="_blank" rel="noopener"
                               class="h-10 rounded-lg border border-outline-variant text-on-surface font-label-md text-label-md hover:bg-surface-container transition-colors flex items-center justify-center gap-1.5 @ring">
                                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">event</span>Add to calendar
                            </a>
                        </div>
                    </div>
                </div>
            </article>
        }
    </section>

    <!-- 4. RECOMMENDED -->
    @if (Model.RecommendedEvents.Count > 0)
    {
        <section aria-labelledby="rec-heading" class="flex flex-col gap-4">
            <div class="flex items-center justify-between gap-4">
                <h2 id="rec-heading" class="@h2">Recommended for you</h2>
                <a asp-controller="Events" asp-action="Index" class="@textLink @ring">
                    Browse all
                    <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_forward</span>
                </a>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                @foreach (var ev in Model.RecommendedEvents.Take(4))
                {
                    <partial name="_EventCard" model="ev" />
                }
            </div>
        </section>
    }

    <!-- 5. SAVED + RECENT BOOKINGS -->
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        <div id="saved" aria-labelledby="saved-heading" class="flex flex-col gap-4 scroll-mt-28">
            <div class="flex items-center justify-between gap-4">
                <h2 id="saved-heading" class="@h2">Saved for later</h2>
                @if (Model.SavedEventsCount > 0)
                {
                    <a asp-controller="Events" asp-action="Saved" class="@textLink @ring">Manage all</a>
                }
            </div>
            <div class="flex flex-col gap-3">
                @if (Model.SavedEvents.Count == 0)
                {
                    <div class="rounded-xl border border-dashed border-outline-variant px-6 py-8 text-center font-body-md text-body-md text-on-surface-variant">
                        Nothing saved yet. Tap the bookmark on any event to keep it here.
                    </div>
                }
                else
                {
                    @foreach (var ev in Model.SavedEvents.Take(4))
                    {
                        <partial name="_SavedEventRow" model="ev" />
                    }
                }
            </div>
        </div>

        <div aria-labelledby="activity-heading" class="flex flex-col gap-4">
            <div class="flex items-center justify-between gap-4">
                <h2 id="activity-heading" class="@h2">Recent bookings</h2>
                @if (activity.Count > 0)
                {
                    <a asp-controller="Bookings" asp-action="Index" class="@textLink @ring">View all</a>
                }
            </div>

            @if (activity.Count == 0)
            {
                <div class="rounded-xl border border-dashed border-outline-variant px-6 py-8 text-center font-body-md text-body-md text-on-surface-variant">
                    Your bookings will appear here.
                </div>
            }
            else
            {
                <ul class="@card divide-y divide-outline-variant overflow-hidden">
                    @foreach (var b in activity)
                    {
                        var paid = string.Equals(b.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase);
                        <li>
                            <a asp-controller="Bookings" asp-action="Details" asp-route-id="@b.TicketOrderId"
                               class="flex items-center gap-4 px-4 py-3.5 hover:bg-surface-container transition-colors @ring">
                                <span class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 @(paid ? "bg-secondary/15 text-secondary" : "bg-surface-container text-on-surface-variant")">
                                    <span class="material-symbols-outlined text-[18px]" aria-hidden="true">@(paid ? "check_circle" : "schedule")</span>
                                </span>
                                <span class="flex-1 min-w-0">
                                    <span class="block font-title-md text-title-md text-on-surface truncate">@b.EventTitle</span>
                                    <span class="block font-body-sm text-body-sm text-on-surface-variant truncate">
                                        @b.TotalTickets @(b.TotalTickets == 1 ? "pass" : "passes") · @UiFormat.Rand(b.TotalAmount) · @b.PaymentStatus
                                    </span>
                                </span>
                                <span class="font-body-sm text-body-sm text-on-surface-variant shrink-0">@UiFormat.Ago(b.BookingDate)</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>
</div>
