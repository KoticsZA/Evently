<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Evently</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
tailwind.config = {
  darkMode: "class",
  theme: {
    extend: {
      colors: {
        "on-error-container": "#ffdad6", "on-secondary": "#452b00", "surface-container-lowest": "#0c0e14",
        "surface-variant": "#33353b", "inverse-surface": "#e2e2ea", "on-tertiary-container": "#404652",
        "on-error": "#690005", "surface-container-low": "#191b22", "secondary-fixed": "#ffddb3",
        "on-primary": "#432c00", "on-tertiary": "#2a313c", "on-background": "#e2e2ea", "surface-tint": "#fabc4d",
        "on-secondary-fixed-variant": "#633f00", "tertiary-fixed": "#dde2f2", "primary": "#ffc665",
        "secondary-fixed-dim": "#ffb952", "outline": "#9d8f7c", "tertiary-fixed-dim": "#c1c6d5", "error": "#ffb4ab",
        "on-primary-container": "#5e4000", "inverse-on-surface": "#2e3037", "surface-bright": "#373940",
        "on-tertiary-fixed-variant": "#414753", "surface-dim": "#111319", "on-secondary-container": "#3c2500",
        "surface": "#111319", "on-primary-fixed": "#281900", "on-tertiary-fixed": "#161c27",
        "outline-variant": "#504535", "secondary": "#ffb952", "surface-container-highest": "#33353b",
        "primary-fixed-dim": "#fabc4d", "inverse-primary": "#7e5700", "background": "#111319",
        "on-surface-variant": "#d4c4b0", "secondary-container": "#c4830e", "error-container": "#93000a",
        "primary-container": "#e5a93c", "tertiary-container": "#aeb4c3", "on-surface": "#e2e2ea",
        "tertiary": "#cacfde", "on-primary-fixed-variant": "#604100", "on-secondary-fixed": "#291800",
        "surface-container": "#1d1f26", "primary-fixed": "#ffdead", "surface-container-high": "#282a30"
      },
      borderRadius: { DEFAULT: "0.125rem", lg: "0.25rem", xl: "0.5rem", full: "0.75rem" },
      spacing: {
        "margin-mobile": "1.25rem", "space-lg": "1.5rem", "space-xl": "2.5rem", "space-md": "1rem",
        gutter: "1.5rem", "gutter-mobile": "1rem", margin: "3rem", "space-sm": "0.5rem", "space-xs": "0.25rem"
      },
      fontFamily: {
        "headline-lg-mobile": ["Playfair Display"], "label-caps": ["Plus Jakarta Sans"],
        "label-md": ["Plus Jakarta Sans"], "label-lg": ["Plus Jakarta Sans"], "body-sm": ["Plus Jakarta Sans"],
        "display-lg-mobile": ["Playfair Display"], "headline-md": ["Playfair Display"],
        "headline-sm": ["Plus Jakarta Sans"], "body-lg": ["Plus Jakarta Sans"], "display-lg": ["Playfair Display"],
        "body-md": ["Plus Jakarta Sans"], "headline-lg": ["Playfair Display"]
      },
      fontSize: {
        "headline-lg-mobile": ["28px", { lineHeight: "36px", letterSpacing: "0em", fontWeight: "600" }],
        "label-caps": ["11px", { lineHeight: "14px", letterSpacing: "0.1em", fontWeight: "700" }],
        "label-md": ["12px", { lineHeight: "16px", letterSpacing: "0.06em", fontWeight: "600" }],
        "label-lg": ["14px", { lineHeight: "20px", letterSpacing: "0.04em", fontWeight: "600" }],
        "body-sm": ["13px", { lineHeight: "20px", fontWeight: "400" }],
        "display-lg-mobile": ["36px", { lineHeight: "44px", letterSpacing: "-0.01em", fontWeight: "600" }],
        "headline-md": ["28px", { lineHeight: "36px", fontWeight: "500" }],
        "headline-sm": ["20px", { lineHeight: "28px", fontWeight: "600" }],
        "body-lg": ["18px", { lineHeight: "28px", fontWeight: "400" }],
        "display-lg": ["56px", { lineHeight: "64px", letterSpacing: "-0.02em", fontWeight: "600" }],
        "body-md": ["15px", { lineHeight: "24px", fontWeight: "400" }],
        "headline-lg": ["40px", { lineHeight: "48px", letterSpacing: "-0.015em", fontWeight: "600" }]
      }
    }
  }
};
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="bg-surface-container-lowest font-body-md text-body-md text-on-surface antialiased min-h-screen flex flex-col justify-between selection:bg-primary selection:text-on-primary">

    <header class="fixed top-0 left-0 right-0 w-full z-50 bg-surface-container-lowest/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
        <div class="h-16 w-full px-margin-mobile lg:px-margin flex items-center justify-between">
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-space-sm">
                <img alt="Evently Brand Mark" class="h-8 w-auto object-contain transition-transform duration-300 hover:scale-105"
                     src="https://lh3.googleusercontent.com/aida/ALJJyrBBT1cHz3IFpzAbDT2K9nrI06BNUbnWRmAVuDuI9frgj_KtcPRLJPACi_GYONJtvj7uM0PA7lA4z84xiA3Mx4pwKh-OBJJOEuR5qhQBaeCVt07vxUi_ZvZOtkTyaZkHBnIWVkVrPw4NAy0_yA6mIFywJK9i1HTHIpWsJv5XkOu_Dg_1-2LoET0kmmsx6-f6aKEFCTeck-kRcHJD9k_d5FUrKnFKx38loWITEcFsKvfM" />
                <span class="font-headline-sm text-headline-sm text-on-surface tracking-tight font-semibold">Evently</span>
            </a>

            <nav class="hidden sm:flex items-center gap-space-lg">
                <a class="font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface transition-colors" href="#">Experiences</a>
                <a class="font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface transition-colors" href="#">Venues</a>
                <a class="font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface transition-colors" href="#">Concierge</a>
            </nav>

            <div class="flex items-center gap-space-md">
                <div class="hidden md:flex items-center gap-space-xs text-on-surface-variant font-label-md text-label-md">
                    <span class="material-symbols-outlined text-[16px]">public</span>
                    <span>South Africa • EN</span>
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" title="Sign out" aria-label="Sign out"
                                class="w-8 h-8 rounded-full bg-primary flex items-center justify-center transition-transform hover:scale-105 cursor-pointer">
                            <span class="material-symbols-outlined text-on-primary text-[18px]">logout</span>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" title="Sign in" aria-label="Sign in"
                       class="w-8 h-8 rounded-full bg-primary flex items-center justify-center transition-transform hover:scale-105">
                        <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
                    </a>
                }
            </div>
        </div>
    </header>

    <main class="w-full pt-16 bg-surface-container-lowest flex-1 flex flex-col">
        @RenderBody()
    </main>

    <footer class="w-full bg-surface-container-lowest shadow-[0_1px_8px_rgba(0,0,0,0.04)] py-space-md z-40">
        <div class="w-full px-margin-mobile lg:px-margin flex flex-col md:flex-row items-center justify-between gap-space-sm font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider">
            <div class="flex items-center gap-space-sm">
                <span>© @DateTime.Now.Year Evently Ltd. All rights reserved.</span>
                <span class="hidden md:inline">•</span>
                <span class="hidden md:inline">Cape Town • Johannesburg • Durban</span>
            </div>
            <div class="flex items-center gap-space-md">
                <div class="flex items-center gap-space-xs text-secondary">
                    <span class="material-symbols-outlined text-[15px]">lock</span>
                    <span>256-bit encrypted ticketing</span>
                </div>
                <div class="flex items-center gap-space-md">
                    <a class="hover:text-on-surface transition-colors" href="#">Terms</a>
                    <a class="hover:text-on-surface transition-colors" href="#">Privacy</a>
                    <a class="hover:text-on-surface transition-colors" href="#">Help</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
