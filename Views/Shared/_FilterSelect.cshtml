@using Evently.ViewModels.Events
@model FilterSelectModel
<div class="flex flex-col gap-1.5 min-w-0">
    <label for="f-@Model.Name" class="font-label-md text-label-md text-on-surface-variant">@Model.Label</label>
    <select id="f-@Model.Name" name="@Model.Name" data-autosubmit
            class="h-10 w-full rounded-lg bg-surface-container-low border border-outline-variant text-on-surface font-body-sm text-body-sm px-3 pr-8 cursor-pointer focus:border-secondary focus:ring-0 focus:outline-none [color-scheme:dark]">
        @foreach (var o in Model.Options)
        {
            <option value="@o.Value" selected="@((Model.Selected ?? "") == o.Value)">@o.Label</option>
        }
    </select>
</div>
