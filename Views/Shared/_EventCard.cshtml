@using Evently.Helpers
@using Evently.ViewModels.Events
@model EventCardViewModel
@{
    int        id        = Model.EventId;
    string     title     = Model.Title;
    string?    imageUrl  = Model.CoverImageUrl;
    string     venue     = Model.VenueName;
    string     city      = Model.City;
    DateTime   start     = Model.StartDateTime;
    decimal?   fromPrice = Model.MinimumTicketPrice;      

    var isFree = fromPrice is null or 0m;
    var saveUrl = Url.Action("ToggleSave", "Events", new { id });
    const string ring = "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary focus-visible:ring-offset-2 focus-visible:ring-offset-surface";
}
<article class="group flex flex-col overflow-hidden rounded-xl border border-outline-variant bg-surface-container-low hover:border-secondary/50 transition-colors">
    <div class="relative aspect-[16/10] w-full overflow-hidden bg-surface-container">
        @if (!string.IsNullOrWhiteSpace(imageUrl))
        {
            <img src="@imageUrl" alt="" loading="lazy" class="w-full h-full object-cover" />
        }
        else
        {
            <div class="w-full h-full flex items-center justify-center text-on-surface-variant">
                <span class="material-symbols-outlined text-[36px]" aria-hidden="true">image</span>
            </div>
        }
        <button type="button" aria-label="Save @title" data-save-toggle data-save-url="@saveUrl"
                class="absolute top-2 right-2 w-10 h-10 rounded-lg bg-surface-container-lowest/80 backdrop-blur-md flex items-center justify-center text-on-surface hover:text-secondary transition-colors cursor-pointer @ring">
            <span class="material-symbols-outlined text-[20px]" aria-hidden="true">bookmark_border</span>
        </button>
    </div>

    <div class="flex flex-1 flex-col gap-4 p-4">
        <div class="min-w-0">
            <h3 class="font-title-md text-title-md text-on-surface line-clamp-1">
                <a asp-controller="Events" asp-action="Details" asp-route-id="@id" class="hover:text-secondary transition-colors rounded @ring">@title</a>
            </h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-1 truncate">@UiFormat.Day(start) · @UiFormat.Time(start)</p>
            <p class="font-body-sm text-body-sm text-on-surface-variant truncate">@(string.IsNullOrWhiteSpace(city) ? venue : venue + ", " + city)</p>
        </div>

        <div class="mt-auto flex items-center justify-between gap-3">
            <span class="font-title-md text-title-md text-on-surface">@(isFree ? "Free" : "From " + UiFormat.Rand(fromPrice!.Value))</span>
            <a asp-controller="Events" asp-action="Details" asp-route-id="@id"
               class="h-9 px-4 inline-flex items-center rounded-lg border border-outline-variant text-on-surface font-label-md text-label-md hover:bg-secondary hover:text-on-secondary-container hover:border-secondary transition-colors @ring">
                @(isFree ? "Reserve" : "Book")
            </a>
        </div>
    </div>
</article>
