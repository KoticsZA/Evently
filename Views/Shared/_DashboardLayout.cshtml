@using System.Security.Claims
@{
    var firstName = ViewData["FirstName"] as string;
    var displayName = !string.IsNullOrWhiteSpace(firstName) ? firstName : (User.Identity?.Name ?? "Guest");
    var active = ViewData["ActiveNav"] as string ?? "";
    var ticketBadge = ViewData["TicketBadge"] as int? ?? 0;

    // TODO: point these at your real controllers/actions. Url.Action returns null when a route doesn't exist, so "#" is the fallback.
    var primaryNav = new[]
    {
        (Key: "overview", Icon: "space_dashboard",       Label: "Overview",        Href: Url.Action("Dashboard", "Account") ?? "#"),
        (Key: "discover", Icon: "explore",               Label: "Discover events", Href: Url.Action("Index", "Events") ?? "#"),
        (Key: "tickets",  Icon: "confirmation_number",   Label: "My tickets",      Href: Url.Action("Index", "Bookings") ?? "#"),
        (Key: "bookings", Icon: "event_seat",            Label: "My bookings",     Href: Url.Action("Index", "Bookings") ?? "#"),
        (Key: "saved",    Icon: "bookmark_border",       Label: "Saved events",    Href: Url.Action("Saved", "Events") ?? "#")
    };
    var accountNav = new[]
    {
        (Key: "profile",       Icon: "person_outline",      Label: "My profile",    Href: Url.Action("Profile", "Account") ?? "#"),
        (Key: "notifications", Icon: "notifications_none",  Label: "Notifications", Href: "#"),
        (Key: "settings",      Icon: "tune",                Label: "Settings",      Href: "#")
    };
    const string activeCls = "bg-surface-container text-[#faf9fd] font-semibold border-l-2 border-secondary";
    const string idleCls = "text-on-surface-variant font-body-md text-body-md hover:bg-surface-container-low hover:text-[#faf9fd]";
}
<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Evently</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
tailwind.config = {
  darkMode: "class",
  theme: {
    extend: {
      colors: {
        "on-primary-fixed-variant": "#604100", "tertiary-fixed-dim": "#c1c6d5", "on-background": "#e2e2ea",
        "surface-bright": "#373940", "primary": "#ffc665", "on-primary-fixed": "#281900",
        "secondary-fixed-dim": "#ffb952", "on-secondary": "#452b00", "outline": "#9d8f7c", "surface": "#111319",
        "surface-container-highest": "#33353b", "on-tertiary": "#2a313c", "surface-variant": "#33353b",
        "outline-variant": "#2a2d37", "surface-container-lowest": "#0c0e14", "error-container": "#93000a",
        "secondary-container": "#e5a93c", "tertiary-fixed": "#dde2f2", "inverse-surface": "#e2e2ea",
        "on-primary": "#432c00", "on-surface": "#e2e2ea", "tertiary": "#cacfde", "surface-dim": "#111319",
        "on-primary-container": "#5e4000", "surface-container-high": "#282a30", "primary-fixed-dim": "#fabc4d",
        "on-error-container": "#ffdad6", "surface-container-low": "#191b22", "surface-tint": "#fabc4d",
        "background": "#111319", "tertiary-container": "#aeb4c3", "secondary": "#e5a93c", "on-error": "#690005",
        "on-secondary-fixed-variant": "#633f00", "inverse-primary": "#7e5700", "primary-container": "#e5a93c",
        "on-secondary-container": "#0c0e14", "on-secondary-fixed": "#291800", "on-tertiary-fixed-variant": "#414753",
        "on-surface-variant": "#8e92a4", "surface-container": "#1d1f26", "on-tertiary-fixed": "#161c27",
        "secondary-fixed": "#ffddb3", "primary-fixed": "#ffdead", "error": "#ffb4ab", "on-tertiary-container": "#404652"
      },
      borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
      spacing: {
        "margin": "3rem", "margin-tablet": "2rem", "gutter-mobile": "1rem", "space-md": "1rem", "space-sm": "0.5rem",
        "gutter": "1.5rem", "space-lg": "1.5rem", "space-xl": "2.5rem", "space-xs": "0.25rem", "margin-mobile": "1.25rem"
      },
      fontFamily: {
        "label-lg": ["Plus Jakarta Sans"], "display-lg": ["Playfair Display"], "headline-md": ["Playfair Display"],
        "headline-lg": ["Playfair Display"], "label-md": ["Plus Jakarta Sans"], "body-lg": ["Plus Jakarta Sans"],
        "body-sm": ["Plus Jakarta Sans"], "title-lg": ["Plus Jakarta Sans"], "label-sm": ["Plus Jakarta Sans"],
        "headline-lg-mobile": ["Playfair Display"], "display-lg-mobile": ["Playfair Display"],
        "headline-sm": ["Plus Jakarta Sans"], "body-md": ["Plus Jakarta Sans"], "title-md": ["Plus Jakarta Sans"]
      },
      fontSize: {
        "label-lg": ["14px", { lineHeight: "20px", letterSpacing: "0.04em", fontWeight: "600" }],
        "display-lg": ["56px", { lineHeight: "64px", letterSpacing: "-0.02em", fontWeight: "600" }],
        "headline-md": ["28px", { lineHeight: "36px", fontWeight: "500" }],
        "headline-lg": ["40px", { lineHeight: "48px", letterSpacing: "-0.015em", fontWeight: "600" }],
        "label-md": ["12px", { lineHeight: "16px", letterSpacing: "0.06em", fontWeight: "600" }],
        "body-lg": ["18px", { lineHeight: "28px", fontWeight: "400" }],
        "body-sm": ["13px", { lineHeight: "20px", fontWeight: "400" }],
        "title-lg": ["18px", { lineHeight: "26px", letterSpacing: "-0.01em", fontWeight: "600" }],
        "label-sm": ["11px", { lineHeight: "14px", letterSpacing: "0.1em", fontWeight: "700" }],
        "headline-lg-mobile": ["28px", { lineHeight: "36px", letterSpacing: "0em", fontWeight: "600" }],
        "display-lg-mobile": ["36px", { lineHeight: "44px", letterSpacing: "-0.01em", fontWeight: "600" }],
        "headline-sm": ["20px", { lineHeight: "28px", fontWeight: "600" }],
        "body-md": ["15px", { lineHeight: "24px", fontWeight: "400" }],
        "title-md": ["16px", { lineHeight: "24px", fontWeight: "600" }]
      }
    }
  }
};
    </script>
    <style>
        html, body { margin: 0; padding: 0; }
        body { overscroll-behavior: none; }
        ::-webkit-scrollbar { display: none; }
        .qr-box img { width: 100%; height: 100%; image-rendering: pixelated; }
    </style>
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="bg-surface font-body-md text-on-surface antialiased">

    <!-- Antiforgery token for fetch() calls (save/unsave) -->
    <form id="antiForgery" class="hidden">@Html.AntiForgeryToken()</form>

    <div id="sidebarOverlay" class="hidden fixed inset-0 bg-black/60 z-40 lg:hidden"></div>

    <aside id="sidebar"
           class="fixed left-0 top-0 h-full w-[260px] bg-surface-container-lowest border-r border-[#222530] flex flex-col justify-between z-50 shadow-[4px_0_24px_rgba(0,0,0,0.4)] -translate-x-full lg:translate-x-0 transition-transform duration-300 overflow-y-auto">
        <div class="flex flex-col">
            <div class="h-20 px-space-lg flex items-center justify-between border-b border-[#222530]/60">
                <a asp-controller="Home" asp-action="Index" class="flex items-baseline gap-space-xs">
                    <span class="font-headline-md text-headline-md tracking-tight text-[#faf9fd]">Evently</span>
                    <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                </a>
                <span class="px-2 py-0.5 rounded-full bg-surface-container font-label-sm text-label-sm text-secondary tracking-widest uppercase border border-secondary/30">Attendee</span>
            </div>

            <nav class="flex flex-col gap-1 px-space-sm pt-space-md" aria-label="Primary">
                @foreach (var item in primaryNav)
                {
                    var isActive = item.Key == active;
                    <a href="@item.Href" aria-current="@(isActive ? "page" : null)"
                       class="group flex items-center justify-between px-space-md py-2.5 rounded transition-colors @(isActive ? activeCls : idleCls)">
                        <span class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-[20px] @(isActive ? "text-secondary" : "")">@item.Icon</span>
                            <span>@item.Label</span>
                        </span>
                        @if (item.Key == "tickets" && ticketBadge > 0)
                        {
                            <span class="px-2 py-0.5 rounded-full bg-secondary text-[#0c0e14] font-label-sm text-label-sm font-bold">@ticketBadge</span>
                        }
                    </a>
                }
            </nav>

            <div class="px-space-md pt-space-lg pb-space-xs">
                <span class="font-label-sm text-label-sm uppercase tracking-wider text-[#63687b]">Account &amp; System</span>
            </div>

            <nav class="flex flex-col gap-1 px-space-sm" aria-label="Account">
                @foreach (var item in accountNav)
                {
                    var isActive = item.Key == active;
                    <a href="@item.Href" aria-current="@(isActive ? "page" : null)"
                       class="group flex items-center px-space-md py-2.5 rounded transition-colors @(isActive ? activeCls : idleCls)">
                        <span class="material-symbols-outlined text-[20px] mr-3">@item.Icon</span>
                        <span>@item.Label</span>
                    </a>
                }
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit"
                            class="w-full group flex items-center px-space-md py-2.5 rounded transition-colors text-left cursor-pointer @idleCls">
                        <span class="material-symbols-outlined text-[20px] mr-3">logout</span>
                        <span>Sign out</span>
                    </button>
                </form>
            </nav>
        </div>

        <div class="p-space-md m-space-sm rounded-xl bg-surface-container-low border border-[#222530] shadow-md">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-secondary flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[#0c0e14] text-[18px] font-bold">person</span>
                </div>
                <div class="flex flex-col min-w-0 flex-1">
                    <span class="font-title-md text-title-md text-[#faf9fd] truncate">@displayName</span>
                    <div class="flex items-center gap-1 text-on-surface-variant font-body-sm text-body-sm">
                        <span class="material-symbols-outlined text-[14px] text-secondary">near_me</span>
                        <span class="truncate">South Africa</span>
                    </div>
                </div>
            </div>
        </div>
    </aside>

    <div class="lg:pl-[260px] min-h-screen flex flex-col justify-between">
        <header class="fixed top-0 left-0 lg:left-[260px] right-0 h-20 bg-surface-container-lowest/90 backdrop-blur-xl z-30 border-b border-[#222530] shadow-sm">
            <div class="h-20 w-full px-space-md lg:px-space-lg flex items-center justify-between gap-space-md">
                <div class="flex items-center gap-space-md">
                    <button id="sidebarToggle" type="button" aria-label="Open menu" aria-controls="sidebar"
                            class="lg:hidden p-2 rounded-full hover:bg-surface-container text-[#faf9fd] transition-colors">
                        <span class="material-symbols-outlined text-[22px]">menu</span>
                    </button>
                    <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container-low border border-[#222530] text-[#faf9fd] font-body-sm text-body-sm">
                        <span class="material-symbols-outlined text-[16px] text-secondary">location_on</span>
                        <span>Western Cape • Cape Town</span>
                    </div>
                    <div class="hidden xl:flex items-center text-on-surface-variant font-body-sm text-body-sm gap-2">
                        <span class="material-symbols-outlined text-[16px] text-secondary">verified</span>
                        <span class="tracking-wide">Concierge Active</span>
                    </div>
                </div>

                <div class="flex items-center gap-space-sm sm:gap-space-md">
                    <button type="button" data-focus="#eventSearch"
                            class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-container-low border border-[#222530] text-on-surface-variant font-body-sm text-body-sm hover:text-[#faf9fd] hover:bg-surface-container transition-colors">
                        <span class="material-symbols-outlined text-[18px] text-secondary">search</span>
                        <span class="hidden sm:inline">Search curations</span>
                    </button>
                    <a href="#" class="flex items-center gap-1.5 px-3 py-1.5 rounded text-on-surface-variant hover:text-[#faf9fd] font-body-sm text-body-sm transition-colors">
                        <span class="material-symbols-outlined text-[18px]">help_outline</span>
                        <span class="hidden md:inline">Assistance</span>
                    </a>
                    <div class="w-8 h-8 rounded-full bg-secondary text-[#0c0e14] font-bold flex items-center justify-center" title="@displayName">
                        <span class="material-symbols-outlined text-[18px]">person</span>
                    </div>
                </div>
            </div>
        </header>

        <main class="w-full pt-20 bg-surface flex-1">
            @RenderBody()
        </main>

        <footer class="w-full bg-surface-container-lowest border-t border-[#222530] py-space-md">
            <div class="w-full px-space-md lg:px-space-lg flex flex-col sm:flex-row items-center justify-between gap-space-sm text-on-surface-variant font-body-sm text-body-sm">
                <div class="flex items-center gap-1 flex-wrap justify-center">
                    <span class="font-headline-sm text-headline-sm text-[#faf9fd]">Evently</span>
                    <span class="mx-2 text-secondary">•</span>
                    <span>Exclusive cultural, arts &amp; dining access across South Africa</span>
                </div>
                <div class="flex items-center gap-space-lg flex-wrap justify-center">
                    <a class="text-[#8e92a4] hover:text-[#faf9fd] transition-colors" href="#">Privacy Policy</a>
                    <a class="text-[#8e92a4] hover:text-[#faf9fd] transition-colors" href="#">Patron Terms</a>
                    <a class="text-[#8e92a4] hover:text-[#faf9fd] transition-colors" href="#">Concierge Desk</a>
                    <span class="text-[#63687b]">© @DateTime.Now.Year Evently (Pty) Ltd.</span>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
